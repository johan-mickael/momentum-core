{
    "settings": {
        "number_of_shards": 1,
        "number_of_replicas": 0
    },
    "mappings": {
        "properties": {
            "id": { "type": "keyword" },
            "name": {
                "type": "text",
                "fields": {
                    "keyword": { "type": "keyword" }
                }
            },
            "description": { "type": "text" },
            "genre": { "type": "keyword" },
            "status": { "type": "keyword" },
            "startAt": { "type": "date" },
            "endAt": { "type": "date" },
            "slug": { "type": "keyword", "index": false },
            "imageUrl": { "type": "keyword", "index": false },
            "venueId": { "type": "keyword" },
            "venueName": { "type": "keyword" },
            "venue": {
                "properties": {
                    "street": { "type": "keyword", "index": false },
                    "city": { "type": "keyword" },
                    "zipCode": { "type": "keyword", "index": false },
                    "country": { "type": "keyword" },
                    "location": { "type": "geo_point" }
                }
            },
            "minPrice": { "type": "integer" },
            "maxPrice": { "type": "integer" },
            "currency": { "type": "keyword" },
            "popularity": { "type": "integer" }
        }
    }
}
